<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.hi.project.dao.PostLikeDao">

    <insert id="insertLike" parameterType="kr.hi.project.dto.PostLikeDTO">
        INSERT INTO post_like (post_num, user_num)
        VALUES (#{postNum}, #{userNum})
    </insert>

    <delete id="deleteLike" parameterType="kr.hi.project.dto.PostLikeDTO">
        DELETE FROM post_like 
        WHERE post_num = #{postNum} AND user_num = #{userNum}
    </delete>

    <select id="checkLikeStatus" parameterType="kr.hi.project.dto.PostLikeDTO" resultType="int">
        SELECT COUNT(*) FROM post_like 
        WHERE post_num = #{postNum} AND user_num = #{userNum}
    </select>

    <select id="countLikesByPostNum" resultType="int">
        SELECT COUNT(*) FROM post_like WHERE post_num = #{postNum}
    </select>

</mapper>